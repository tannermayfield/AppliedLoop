# Copy to .env.local and fill in. Never commit .env.local.
# Server-only: none of these may be exposed to browser code (no NEXT_PUBLIC_ prefix; the production
# check rejects a NEXT_PUBLIC_ variable whose name says it holds a credential).
#
# PRODUCTION (Vercel, "Production" environment): the app refuses to start, and the deploy fails
# before going live, unless the variables marked [prod] are valid. `pnpm env:check` lists every
# problem at once (names and rules, never values). The full table is in docs/RUNBOOK.md and the
# step-by-step setup in docs/DEPLOY.md.

# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the app uses PGlite (an embedded Postgres)
# and keeps its files under PGLITE_DATA_DIR.
# [prod, required] Neon's POOLED connection string (the host contains "-pooler").
DATABASE_URL=
# [prod, recommended] Neon's DIRECT (unpooled) connection string. Used only by migrations
# (`pnpm db:migrate` and the Vercel build). The Vercel Neon integration sets it for you.
DATABASE_URL_UNPOOLED=
PGLITE_DATA_DIR=.data/pglite

# --- Auth (Better Auth) --------------------------------------------------------
# [prod, required, at least 32 characters] Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs every student out (see docs/RUNBOOK.md, "Rotating secrets").
BETTER_AUTH_SECRET=
# [prod, required, https://] The public origin of the app (used for OAuth callbacks).
BETTER_AUTH_URL=http://localhost:3000
# [prod, at least one complete pair] OAuth providers show up on the sign-in page when both values
# are present. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and .../google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [prod, recommended for the pilot] Comma-separated emails allowed to sign in. Empty = anyone with a
# Google or GitHub account. Checked on every request: removing an email ends that student's access
# immediately.
AUTH_ALLOWED_EMAILS=
# DEVELOPMENT ONLY. Shows an email-only sign-in form. The app refuses to start in production
# with it set, and the production build forces it off.
AUTH_DEV_LOGIN=1

# --- AI ------------------------------------------------------------------------
# demo = deterministic canned responses, no key needed (the UI shows a "Demo AI" banner).
#        Development only: production refuses to start with AI_MODE=demo.
# live = real models through the AI Gateway (needs AI_GATEWAY_API_KEY and the model ids below)
# off  = AI endpoints return AI_UNAVAILABLE and the manual flows are used
# Unset: live if AI_GATEWAY_API_KEY is set, otherwise demo in development and OFF in production
# (a deployed app never silently fakes its AI).
# [prod] When live (explicitly, or because a key is set), the key and ALL FOUR model ids are required.
AI_MODE=
AI_GATEWAY_API_KEY=
# Model ids use the gateway's "provider/model" format. List current ones with:
#   curl -s https://ai-gateway.vercel.sh/v1/models
# No model id is hard-coded anywhere in the application.
AI_MODEL_CAPTURE=
AI_MODEL_OPPORTUNITY=
AI_MODEL_TUTOR=
AI_MODEL_EXTRACTION=
# Per-user cap on AI calls per rolling hour.
AI_RATE_LIMIT_PER_HOUR=60

# --- GitHub App (P1: repository linking + artifact selection) ------------------------------
# Optional, and separate from "Sign in with GitHub" above (ADR-0002). Set ALL six or none.
# With none, the UI says "GitHub linking isn't set up" and pasted links keep working; a partial
# or malformed set is ignored with a startup warning naming the variable (never its value).
# Registration steps: docs/integrations/github-app.md
GITHUB_APP_ID=
# The App's URL name: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App's private key (PEM). A one-line value with \n escapes is fine.
GITHUB_APP_PRIVATE_KEY=
# The same long random value as in the App's webhook settings (at least 16 characters).
GITHUB_APP_WEBHOOK_SECRET=

# --- Operations (all optional) ---------------------------------------------------
# [prod, recommended] Where unhandled server errors are POSTed as sanitized JSON (an https URL,
# for example a Slack incoming webhook). Treat the URL as a secret. Unset = errors go to the logs only.
ERROR_WEBHOOK_URL=
# debug | info | warn | error | silent. Default: info in production, debug in development.
# Set debug in production only while troubleshooting, then unset it.
LOG_LEVEL=
# Vercel PREVIEW deployments never run migrations unless this is 1 (and the Preview environment has
# its OWN DATABASE_URL, never the production one). See docs/DEPLOY.md.
MIGRATE_ON_PREVIEW=
